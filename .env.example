# Copy to .env.local and fill in. Google Ads stays completely off while the ID is empty.
# Google Ads → Tools → Data manager → Google tag (looks like AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads → Goals → Conversions → (action) → Tag setup → "send_to": AW-…/<LABEL>
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
