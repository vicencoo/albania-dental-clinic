# Copy to .env.local and fill in. Google Ads stays completely off while the ID is empty.
# Google Ads → Tools → Data manager → Google tag (looks like AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads → Goals → Conversions → (action) → Tag setup → "send_to": AW-…/<LABEL>
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Consultation / contact form → email to the clinic (https://resend.com, free tier is enough).
# 1. Create an API key: Resend → API Keys.
# 2. Verify the website's domain in Resend → Domains, then send from an address on it.
#    (Before the domain is verified you can test with onboarding@resend.dev, which only
#    delivers to the email you signed up to Resend with.)
RESEND_API_KEY=
# Where requests are delivered (several addresses: comma-separated).
CONSULTATION_TO_EMAIL=
# Sender, e.g. "Albania Dental Clinic <website@your-domain.com>"
CONSULTATION_FROM_EMAIL=
